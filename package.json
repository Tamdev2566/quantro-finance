{
  "name": "apex-finance-accounting",
  "version": "1.0.0",
  "description": "Real-time Enterprise Finance & Accounting Application",
  "scripts": {
    "build": "npm run install:all && cd frontend && npm run build",
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "start": "node backend/src/server.js",
    "start:backend": "cd backend && npm start",
    "dev:backend": "cd backend && npm run dev",
    "start:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "test": "cd backend && npm test"
  }
}
